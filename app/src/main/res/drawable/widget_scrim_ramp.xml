<?xml version="1.0" encoding="utf-8"?>
<!--
  The middle band of the widget's scrim. The widget lays out three strips:
  0-40% solid ScrimStrong, 40-60% this ramp, 60-100% nothing at all. Angle 0
  runs left to right, so the dark end lines up with the solid strip beside it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#E610241C"
        android:centerColor="#7A10241C"
        android:endColor="#0010241C" />
</shape>